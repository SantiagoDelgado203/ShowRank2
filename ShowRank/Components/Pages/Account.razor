@page "/account"
@page "/account/{Mode}"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using ShowRank.Models
@using ShowRank.Services
@inject AuthService AuthService
@inject NavigationManager Nav

<PageTitle>Sign In or Sign Up – ShowRank</PageTitle>

<AuthorizeView Context="authState">
    <Authorized>
        <section class="auth-section">
            <div class="auth-card">
                <h2>Hi, @authState.User.Identity?.Name</h2>
                <p class="auth-message">You're signed in as @authState.User.FindFirst(ClaimTypes.Email)?.Value.</p>
                <a class="btn btn-outline-secondary w-100" href="logout">Sign out</a>
            </div>
        </section>
    </Authorized>
    <NotAuthorized>
        <section class="auth-section">
            <div class="auth-card">
                <div class="auth-tabs">
            <a href="/account" class="auth-tab @(ShowSignUp ? "" : "active")">
                Sign In
            </a>
            <a href="/account/signup" class="auth-tab @(ShowSignUp ? "active" : "")">
                Create Account
            </a>
        </div>

        @if (!ShowSignUp)
        {
            <EditForm Model="@signInModel" FormName="signin" OnValidSubmit="HandleSignIn" class="auth-form">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="signInModel.Email" placeholder="you@example.com" />
                    <ValidationMessage For="@(() => signInModel.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="signInModel.Password" placeholder="••••••••" />
                    <ValidationMessage For="@(() => signInModel.Password)" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Sign In</button>

                @if (!string.IsNullOrEmpty(authMessage))
                {
                    <p class="auth-message">@authMessage</p>
                }
            </EditForm>
        }
        else
        {
            <EditForm Model="@signUpModel" FormName="signup" OnValidSubmit="HandleSignUp" class="auth-form">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Display Name</label>
                    <InputText class="form-control" @bind-Value="signUpModel.DisplayName" placeholder="Your name" />
                    <ValidationMessage For="@(() => signUpModel.DisplayName)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="signUpModel.Email" placeholder="you@example.com" />
                    <ValidationMessage For="@(() => signUpModel.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="signUpModel.Password" placeholder="••••••••" />
                    <ValidationMessage For="@(() => signUpModel.Password)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirm Password</label>
                    <InputText type="password" class="form-control" @bind-Value="signUpModel.ConfirmPassword" placeholder="••••••••" />
                    <ValidationMessage For="@(() => signUpModel.ConfirmPassword)" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Create Account</button>

                @if (!string.IsNullOrEmpty(authMessage))
                {
                    <p class="auth-message">@authMessage</p>
                }
            </EditForm>
        }
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string? Mode { get; set; }

    [SupplyParameterFromForm(FormName = "signin")]
    private SignInModel signInModel { get; set; } = new();

    [SupplyParameterFromForm(FormName = "signup")]
    private SignUpModel signUpModel { get; set; } = new();

    private string? authMessage;

    private bool ShowSignUp => string.Equals(Mode, "signup", StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        signInModel ??= new();
        signUpModel ??= new();
    }

    private async Task HandleSignIn()
    {
        var (success, error, user) = await AuthService.ValidateCredentialsAsync(signInModel);
        if (!success || user is null)
        {
            authMessage = error;
            return;
        }

        await SignInUserAsync(user);
    }

    private async Task HandleSignUp()
    {
        var (success, error, user) = await AuthService.RegisterAsync(signUpModel);
        if (!success || user is null)
        {
            authMessage = error;
            return;
        }

        await SignInUserAsync(user);
    }

    private async Task SignInUserAsync(Models.User user)
    {
        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, user.Id.ToString()),
            new(ClaimTypes.Name, user.DisplayName),
            new(ClaimTypes.Email, user.Email),
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));
        Nav.NavigateTo("/", forceLoad: true);
    }
}
