@* All the files in layout folder are basically the UI wrappers. *@

@* Basically just a constant frame. *@
@* Reduces HTML code - if this wasn't there you would have to add this in every razor. *@

@inherits LayoutComponentBase

<div class="page">
    <NavMenu />

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
